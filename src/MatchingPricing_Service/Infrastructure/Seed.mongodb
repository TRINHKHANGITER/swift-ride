  }
]

drivers.forEach(driver => {
  db.driver_locations.updateOne(
    {
      driverUuid: driver.driverUuid
    },
    {
      $set: {
        location: driver.location,
        isOnline: driver.isOnline,
        isAvailable: driver.isAvailable,
        updatedAt: driver.updatedAt
      },
      $setOnInsert: {
        driverUuid: driver.driverUuid
      }
    },
    {
      upsert: true
    }
  )
})
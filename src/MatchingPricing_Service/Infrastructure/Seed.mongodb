    location: {
      type: "Point",
      coordinates: [106.690500, 10.775400]
    },
    isOnline: true,
    isAvailable: true,
    updatedAt: now
  },
  {
    // Trần Minh Hoàng
    driverUuid: UUID("c3a8f6d2-91b4-47e0-a56c-2d9f8b7e1345"),
    location: {
      type: "Point",
      coordinates: [106.688900, 10.773800]
    },
    isOnline: true,
    isAvailable: true,
    updatedAt: now
  },
  {
    // Lê Quốc Bảo
    driverUuid: UUID("1e6b9c74-5d32-48af-b103-7c2e9a6f4d81"),
    location: {
      type: "Point",
      coordinates: [106.693000, 10.778000]
    },
    isOnline: true,
    isAvailable: true,
    updatedAt: now
  },
  {
    // Phạm Đức Huy
    driverUuid: UUID("a52d7e19-c684-4f3b-8a20-9d1c5e7b436f"),
    location: {
      type: "Point",
      coordinates: [106.685000, 10.770000]
    },
